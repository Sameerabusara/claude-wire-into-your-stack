{
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": {
        "tool": "Bash",
        "pattern": "git commit"
      },
      "command": "npm run lint",
      "description": "Lint the codebase before allowing commits",
      "allowedTools": ["Bash"]
    }
  ],
  "permissions": [
    {
      "tool": "Bash",
      "pattern": "npm (run (test|lint)|test)",
      "scope": "project"
    }
  ]
}
